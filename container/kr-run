#!/bin/sh
# Agent-facing boundary INSIDE the sealed container.
#   kr-run agent  '<pipeline>'  -> raw output to tmpfs only; stdout = kr-redact view
#   kr-run human  '<pipeline>'  -> raw output (keys!) to the human's /dev/tty
# The pipeline is a shell command line built from keyrescue tools, e.g.
#   seed-repair --in /in/seed.txt | derive --count 5
set -eu
mode="${1:-}"; pipeline="${2:-}"
[ -n "$pipeline" ] || { echo '{"tool":"kr-redact","status":"bad_input"}'; exit 2; }
umask 077
case "$mode" in
  agent)
 stderr of tools is also kept off the agent channel.# stderr of tools is also kept off the agent channel.
 stderr of tools is also kept off the agent channel.sh -c "$pipeline" 2>/dev/null | kr-redact
 stderr of tools is also kept off the agent channel.;;
  human)
 stderr of tools is also kept off the agent channel.[ -t 0 ] && [ -t 1 ] || { echo '{"tool":"kr-redact","status":"bad_input"}'; exit 3; }
 stderr of tools is also kept off the agent channel.code=$(od -An -N3 -tu1 /dev/urandom | tr -s ' ' '-' | sed 's/^-//;s/-$//')
 stderr of tools is also kept off the agent channel.printf 'This will print PRIVATE KEYS to this terminal.\nType the code %s to continue: ' "$code" > /dev/tty
 stderr of tools is also kept off the agent channel.read -r answer < /dev/tty
 stderr of tools is also kept off the agent channel.[ "$answer" = "$code" ] || { echo "aborted" > /dev/tty; exit 4; }
 stderr of tools is also kept off the agent channel.sh -c "$pipeline" > /dev/tty 2>&1
 stderr of tools is also kept off the agent channel.echo '{"tool":"kr-redact","status":"done"}'
 stderr of tools is also kept off the agent channel.;;
  *) echo '{"tool":"kr-redact","status":"bad_input"}'; exit 2 ;;
esac

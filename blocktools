#!/bin/sh
# Thin host-side wrapper. Runs a blocktools pipeline in a sealed container.
#   ./blocktools run    '<pipeline>'   # agent-safe: prints only addresses/paths/statuses
#   ./blocktools reveal '<pipeline>'   # human only: needs a TTY + typed code, prints keys
#   ./blocktools build
# Inputs: $BLOCKTOOLS_IN (default ./in), read-only at /in.
# Secrets (passwords/passphrases) : $BLOCKTOOLS_SECRETS (default ./secrets), read-only at /secrets.
set -eu
IMAGE="${BLOCKTOOLS_IMAGE:-blocktools:local}"; DOCKER="${BLOCKTOOLS_DOCKER:-docker}"
IN="${BLOCKTOOLS_IN:-$PWD/in}"; SECRETS="${BLOCKTOOLS_SECRETS:-$PWD/secrets}"
mkdir -p "$IN" "$SECRETS"; chmod 700 "$SECRETS"
# No host bind mounts and no volumes: on Battleaxe the engine is Docker Desktop on Windows, whose VM does not
# see WSL2 distro paths, so a bind mount of ./in arrives empty (same cause as release-repos.sh, 8a7b876).
# ./in and ./secrets travel as tar streams on stdin (`docker exec -i -u 0 ... sealed-run unpack`, never
# through a host temp file) into tmpfs mounts of the sealed container itself (RAM: nothing reaches the
# engine's disk), unpacked as root-owned 0444 files in 0555 dirs, so uid 10001 reads them and cannot change
# them. The pipeline starts only once /secrets opens. The container (and with it the tmpfs) is removed on
# exit, also on failure or Ctrl-C.
# A remote engine (ssh:// or tcp:// context or DOCKER_HOST) is refused: ./secrets would be copied to that host.
# BLOCKTOOLS_ALLOW_REMOTE=ssh permits only ssh:// engines (encrypted, into tmpfs); =1 permits any remote engine.
remote_engine() {
  h="${DOCKER_HOST:-}"
  [ -n "$h" ] || h=$($DOCKER context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null) || h=
  case "$h" in ssh://*|tcp://*|http://*|https://*) echo "$h";; esac
}
# tar of a directory's contents, owned by the container user (10001), so a chmod 600 secret stays readable
# inside and nothing else is; GNU tar (Linux/WSL) or bsdtar (macOS).
tar_as_user() {
  if tar --version 2>/dev/null | grep -q 'GNU tar'; then tar -C "$1" --owner=10001 --group=10001 --numeric-owner -cf - .
  else tar -C "$1" --uid 10001 --gid 10001 -cf - .; fi
}
VOLS=""; STAGER=""
unseal() {  # idempotent cleanup; never prints input contents
  [ -z "$CID" ] || $DOCKER rm -f "$CID" >/dev/null 2>&1 || :
  [ -z "$APID" ] || kill "$APID" 2>/dev/null || :
  CID=""; APID=""
}
stage_in() {  # stage_in HOSTDIR DEST: stream HOSTDIR's contents into the running container's DEST tmpfs
  if (set -o pipefail) 2>/dev/null; then set -o pipefail; fi
  err=$(tar_as_user "$1" | $DOCKER exec -i -u 0 "$CID" /blocktools/sealed-run unpack "$2" 2>&1 >/dev/null) || {
    echo "blocktools: copying $2 into the container failed: $err" >&2; exit 5; }
}
CID=""; APID=""
seal() {
  r=$(remote_engine)
  if [ -n "$r" ]; then
    case "${BLOCKTOOLS_ALLOW_REMOTE:-}:$r" in
      1:*) ;;
      ssh:ssh://*) ;;
      ssh:*) echo "blocktools: docker engine is remote ($r) and not ssh://: BLOCKTOOLS_ALLOW_REMOTE=ssh permits only ssh:// engines (./secrets would cross the wire unencrypted). Use an ssh:// context or a local engine." >&2; exit 4;;
      *) echo "blocktools: docker engine is remote ($r): ./in and ./secrets would be copied to that host. Use a local engine (e.g. docker context use desktop-linux), set BLOCKTOOLS_ALLOW_REMOTE=ssh for an ssh:// engine, or BLOCKTOOLS_ALLOW_REMOTE=1 for any remote engine." >&2; exit 4;;
    esac
  fi
  flags="$1"; shift
  tag="blocktools-$$-$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
  trap unseal EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
  # the tmpfs mounts count against --memory 2g; refuse up front rather than fail half-way through the copy
  insize="${BLOCKTOOLS_IN_SIZE_MB:-512}"
  case "$insize" in ''|*[!0-9]*) echo "blocktools: BLOCKTOOLS_IN_SIZE_MB must be a number of MB" >&2; exit 5;; esac
  [ "$(du -sk "$IN" | cut -f1)" -lt $((insize * 1024)) ] || { echo "blocktools: $IN is larger than the ${insize} MB /in tmpfs (set BLOCKTOOLS_IN_SIZE_MB)" >&2; exit 5; }
  [ "$(du -sk "$SECRETS" | cut -f1)" -lt 16384 ] || { echo "blocktools: $SECRETS is larger than the 16 MB /secrets tmpfs" >&2; exit 5; }
  # BLOCKTOOLS_SEAL_PROBE=FILE: keep the container after the run and write its id to FILE, so
  # scripts/sealed-check.sh can inspect the exact flags below (it removes the container).
  rm=--rm; [ -z "${BLOCKTOOLS_SEAL_PROBE:-}" ] || rm=
  CID=$($DOCKER create $rm $flags \
    --network none --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --user 10001:10001 --pids-limit 64 --memory 2g --memory-swap 2g --cpus 2 \
    --tmpfs /run/blocktools:rw,noexec,nosuid,nodev,size=64m,mode=0700,uid=10001 \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10001 \
    --tmpfs "/in:rw,noexec,nosuid,nodev,size=${insize}m,mode=0700,uid=0,gid=0" \
    --tmpfs /secrets:rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=0,gid=0 \
    --label "blocktools.sealed=$tag" --log-driver none \
    "$IMAGE" staged "$@")
  [ -z "${BLOCKTOOLS_SEAL_PROBE:-}" ] || echo "$CID" > "$BLOCKTOOLS_SEAL_PROBE"
  case "$flags" in
    *t*) $DOCKER start -ai "$CID" < /dev/tty & ;;
    *) $DOCKER start -a "$CID" < /dev/null & ;;
  esac
  APID=$!
  i=0; until [ "$($DOCKER inspect -f '{{.State.Running}}' "$CID" 2>/dev/null)" = true ]; do
    i=$((i + 1)); [ $i -lt 300 ] || { echo "blocktools: sealed container did not start" >&2; exit 5; }
    kill -0 "$APID" 2>/dev/null || { echo "blocktools: sealed container did not start" >&2; exit 5; }
    sleep 0.1 2>/dev/null || sleep 1
  done
  stage_in "$IN" /in
  stage_in "$SECRETS" /secrets   # last: the pipeline starts when /secrets opens
  rc=0; wait "$APID" || rc=$?; APID=""
  [ -z "${BLOCKTOOLS_SEAL_PROBE:-}" ] || CID=""
  return $rc
}
case "${1:-}" in
  build) d=$(dirname "$0"); c=$(git -C "$d" rev-parse HEAD 2>/dev/null || echo unknown)
         [ -z "$(git -C "$d" status --porcelain --untracked-files=no 2>/dev/null)" ] || c="$c-dirty"
         $DOCKER build --build-arg "BLOCKTOOLS_COMMIT=$c" -t "$IMAGE" "$d" ;;
  run) shift; seal -i agent "$*" < /dev/null ;;
  reveal) shift; [ -t 0 ] || { echo "reveal needs a human at a terminal" >&2; exit 3; }; seal -it human "$*" ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
